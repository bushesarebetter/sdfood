# ── Google Maps ───────────────────────────────────────────────────────────────
# Required. The same key as the intersection site works if its referrer list
# includes this site's domain. Enable on the project:
#   - Maps JavaScript API        (basemap + deck.gl overlay)
#   - Street View Static API     (the embedded pano)
#   - Places API (New)           (address suggestions in "Near an address")
#   - Geocoding API              (a typed address that was not picked from the list)
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Required for vector rendering (deck.gl). Google Maps Platform → Map Management
# → Create Map ID (JavaScript, Vector). Falls back to DEMO_MAP_ID if unset.
VITE_GOOGLE_MAPS_MAP_ID=your_map_id_here

# ── Analytics (optional) ─────────────────────────────────────────────────────
# Unset means no analytics at all, and the privacy page says so.
VITE_ANALYTICS_SRC=
VITE_ANALYTICS_SITE=
